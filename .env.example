# ─────────────────────────────────────────────────────────────
#  SOLBRIEF environment. Copy to .env.local for local dev and
#  add the same keys in Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Public URL of the deployment (used for SIWS domain checks, OG tags, digest links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Access token ($BRIEF) ────────────────────────────────────
# SPL mint address. Leave empty until launch (everyone is FREE tier).
# Also enables the pump.fun button (https://pump.fun/coin/<mint>).
NEXT_PUBLIC_TOKEN_MINT=
# X / Twitter account for the X button: a handle (solbrief / @solbrief) or full URL.
# Leave empty to hide the button.
NEXT_PUBLIC_X_HANDLE=

# ── Supabase (server only — never expose the service role key) ─
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Gemini ───────────────────────────────────────────────────
GEMINI_API_KEY=
# Optional overrides (defaults live in src/config/site.ts)
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# GEMINI_RPM=8

# ── Solana RPC ───────────────────────────────────────────────
# Helius free tier: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Falls back to the public mainnet RPC (heavily rate limited) when empty.
SOLANA_RPC_URL=
# Public RPC for the browser wallet adapter (does not need to be Helius)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ── Optional data source keys (all have keyless fallbacks) ────
# CoinGecko demo key (free): raises rate limits
COINGECKO_API_KEY=
# Jupiter API key (free at portal.jup.ag). Empty = keyless lite-api.jup.ag
JUPITER_API_KEY=

# ── Auth & security ──────────────────────────────────────────
# 32+ random bytes: `openssl rand -base64 48`
SESSION_SECRET=
# Shared secret for /api/cron/* (Vercel Cron sends it as `Authorization: Bearer`)
CRON_SECRET=
# Comma-separated wallet addresses allowed into /admin
ADMIN_WALLETS=

# ── Digest delivery (WHALE tier, optional) ────────────────────
# Telegram: create a bot with @BotFather
TELEGRAM_BOT_TOKEN=
# Email via Resend (free tier): https://resend.com
RESEND_API_KEY=
EMAIL_FROM="SOLBRIEF <brief@yourdomain.com>"

# ── Local development only ───────────────────────────────────
# Without SUPABASE_URL the app uses a JSON file store in ./.data (dev only).
# Force a tier for every signed-in wallet while developing (ignored in production).
# DEV_TIER_OVERRIDE=WHALE
