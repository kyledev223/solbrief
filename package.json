{
  "name": "solbrief",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pipeline": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/run-pipeline.ts",
    "smoke": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/smoke-fetchers.ts",
    "brand": "tsx scripts/render-brand.tsx"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@solana/wallet-adapter-base": "^0.9.28",
    "@solana/wallet-adapter-phantom": "^0.9.30",
    "@solana/wallet-adapter-react": "^0.15.40",
    "@solana/wallet-adapter-solflare": "^0.6.34",
    "@solana/web3.js": "^1.99.0",
    "@supabase/supabase-js": "^2.118.0",
    "bs58": "^6.0.0",
    "fast-xml-parser": "^5.11.2",
    "jose": "^6.2.12",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tweetnacl": "^1.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.9"
  }
}
